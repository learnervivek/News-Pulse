# Copy this file to `.env` and adjust the values for your machine.
# Never commit the real .env file - it is listed in .gitignore.

# Port the API listens on
PORT=4000

# Path to the SQLite database file the Python scraper writes to
DB_PATH=../news_pulse.db

# How to run the Python scraper when POST /ingest/trigger is called.
# IMPORTANT: this must be the Python that has the scraper's packages
# installed. If you have more than one Python on your machine, use the
# full path - run `python -c "import sys; print(sys.executable)"` in the
# same terminal where `pip install -r requirements.txt` worked.
PYTHON_BIN=python
SCRAPER_DIR=../scraper
SCRAPER_SCRIPT=main.py

# Which frontend origin is allowed to call this API ("*" allows all)
CORS_ORIGIN=*
